# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- MySQL (relational data) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ecofoodsync_db

# --- MongoDB (tracking events, audit logs, food metadata) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ecofoodsync_nosql

# --- Auth ---
# Generate with: openssl rand -base64 32   (or any random 32+ character string)
AUTH_SECRET=

# Only used by `npm run seed` to create the demo users (min 8 chars, letters + digits)
SEED_PASSWORD=
